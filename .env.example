# Django Settings
DEBUG=0
SECRET_KEY=
DJANGO_SETTINGS_MODULE=wib_challenge.settings.production
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com

# Database
DATABASE_URL=mysql://wib_user:wib_password@db:3306/wib_challenge
MYSQL_DATABASE=wib_challenge
MYSQL_USER=wib_user
MYSQL_PASSWORD=wib_password
MYSQL_ROOT_PASSWORD=root_password

# Redis
REDIS_URL=redis://redis:6379/0

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Email
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# Frontend
FRONTEND_INVITATION_URL=/organizations/invitations/

# AI
GENAI_API_KEY=your-genai-api-key

# Nginx
NGINX_PORT=80

# Security
SECURE_SSL_ENABLED=0